// INSTRUCTIONS:
// 1. Copy this file to secrets.h
// 2. Replace the placeholder values with your actual credentials
// 3. secrets.h is git-ignored and will not be committed
//
// This file is for credentials and user-specific settings only.

#ifndef SECRETS_H
#define SECRETS_H

// WiFi Configuration
#define WIFI_SSID "YourWiFiSSID"           // Your WiFi network name
#define WIFI_PASSWORD "YourWiFiPassword"   // Your WiFi password
#define WIFI_MAX_CONNECT_ATTEMPTS 20      // Max attempts before giving up
#define WIFI_AUTO_RECONNECT true           // Automatically reconnect if disconnected
#define WIFI_RECONNECT_INTERVAL 30.0f      // Base seconds between reconnection attempts (doubles each failure)
#define WIFI_MAX_RECONNECT_INTERVAL 300.0f // Maximum backoff ceiling in seconds

// MQTT Configuration
#define MQTT_SERVER "192.168.1.100"        // Your MQTT broker IP or hostname (e.g., "homeassistant.local")
#define MQTT_PORT 1883                     // MQTT broker port
#define MQTT_CLIENT_ID "object_name"       // Unique client ID for this device
#define MQTT_USERNAME "your_mqtt_username" // MQTT username (set to nullptr if no auth required)
#define MQTT_PASSWORD "your_mqtt_password" // MQTT password (set to nullptr if no auth required)
#define MQTT_KEEP_ALIVE 15                 // MQTT keep-alive interval in seconds
#define MQTT_CLEAN_SESSION true            // Start with a clean session
#define MQTT_AUTO_RECONNECT true           // Automatically reconnect if disconnected
#define MQTT_RECONNECT_INTERVAL 5.0f       // Base seconds between reconnection attempts (doubles each failure)
#define MQTT_MAX_RECONNECT_INTERVAL 120.0f // Maximum backoff ceiling in seconds
#define MQTT_BUFFER_SIZE 2048              // MQTT message buffer size (default: 256, HA discovery needs 2048+)

// Home Assistant Discovery Configuration
#define HA_DISCOVERY_PREFIX "homeassistant"           // HA discovery prefix
#define HA_DEVICE_NAME "My Eclipse Device"            // Device name shown in HA
#define HA_DEVICE_ID "eclipse_device_001"             // Unique device identifier
#define HA_MANUFACTURER "Eclipse OS"                  // Manufacturer name
#define HA_MODEL "Pico W LED Controller"              // Device model
#define HA_SW_VERSION "1.0.0"                         // Software version
#define HA_HW_VERSION "Pico W"                        // Hardware version (optional, can be nullptr)
#define HA_SERIAL_NUMBER nullptr                      // Serial number (optional, can be nullptr)
#define HA_CONFIG_URL "http://192.168.1.169"          // Configuration URL (optional, can be nullptr)
#define HA_ORIGIN_NAME "Eclipse OS"                   // Origin application name
#define HA_ORIGIN_SW_VERSION "1.0.0"                  // Origin software version
#define HA_ORIGIN_SUPPORT_URL "https://github.com/your-repo" // Support URL

#endif // SECRETS_H
