{
  // mythos26, on the ten U'King Par 36.
  //
  // Same rig as uking_par36_x10.json - see that file for the addresses and for
  // why the widget is "enttec_open" rather than "enttec_pro". What is different
  // here is the show: mythos26's own state machine, pulsing on the beat that
  // arrives over MIDI.
  //
  // Bench it with no hardware and no DJ software:
  //   eclipse-dmx --config config/mythos26.json --dry-run --bpm 128 --frames 80
  //
  // See what the machine can hear:
  //   eclipse-dmx --list-midi

  "device": {
    "type": "enttec_open",
    "port": "auto",
    "fps": 40,
    "console_channels": 24
  },

  "master": {
    "brightness": 1.0,
    "gamma": 2.2
  },

  // Tempo in.
  //
  // Mixxx: Preferences > Controllers, load the "MIDI for light" mapping and
  // point its *output* at a virtual cable - loopMIDI on Windows. That cable is
  // what we open here. "auto" will find a port called loopMIDI or Mixxx, but
  // naming it outright is one less thing to be surprised by at load-in, and
  // "--list-midi" prints what this machine can see.
  //
  // The mapping sends notes, not beat clock: note 50 on each beat, and note 52
  // carrying the tempo as velocity + 50. Those are the defaults below. Do not
  // set beat_note to -1 with Mixxx - it also sends VU meters as notes, many
  // times a second, and every one of them would read as a beat.
  //
  // "clock" stays on for anything that is not Mixxx; it costs nothing when no
  // 0xF8 ever arrives.
  //
  // "bpm" is the tempo before anything has been heard, and the one the rig
  // falls back to if the link goes quiet. "free_run" is what makes that a
  // fallback rather than a blackout.
  // "ignore" is what stops "auto" grabbing the DJ controller. It is a MIDI
  // input, it is often the only one on the machine, and every pad on it sends
  // notes - so it is both what auto would reach for and the last thing that
  // should be allowed to move the beat. See config/mythos26_mixxx.json for the
  // load-in version of this block, which names the cable outright instead.
  "midi": {
    "enabled": true,
    "port": "auto",
    "ignore": ["Traktor", "Kontrol"],
    "clock": true,
    "notes": true,
    "beat_note": 50,
    "bpm_note": 52,
    "beat_channel": -1,
    "bpm": 128,
    "free_run": true
  },

  // Seven states, four of them written:
  //
  //   beat_pulse      the whole rig hitting white on each beat - fast up,
  //                   ~200ms back down, so it lands on the beat rather than
  //                   throbbing near it
  //   vu_pulse        the same flash on every second beat, over a red layer
  //                   that follows the VU meter. Needs midi.vu_note.
  //   tv_static_mono  every par a new grey, every frame
  //   tv_static       every par a new colour, every frame
  //
  // slot_5 onwards are placeholders - a dim tinted breath - so the cue buttons
  // and the cross-fades can be proved out before the looks exist.
  //
  // How often the beat-driven looks fire is a desk control, not a config one:
  // "beat div 1|2|4" on stdin, or the on 1 / on 2 / on 4 buttons in the viewer.
  "pattern": {
    "name": "mythos26",
    "state": "beat_pulse",
    "brightness": 1.0
  },

  "fixtures": [
    {
      "profile": "uking_par36",
      "name": "par",
      "address": 1,
      "count": 10
    }
  ]
}
