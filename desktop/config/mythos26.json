{
  // mythos26: the show. An environment - a room with things in it - rather than
  // a rig.
  //
  // Two devices, one look. The pattern renders once into one coordinate space
  // and both the truss and the sculpture take their part of it, which is the
  // difference between a show and two rigs running the same look side by side.
  //
  //   eclipse-dmx --config config/mythos26.json --dry-run --bpm 128 --frames 80
  //   python -m eclipse_dmx view config/mythos26.json --bpm 128
  //
  // Add --live (or drop --dry-run) once both are actually plugged in. Either
  // device can be commented out and the show still runs on the other.

  "master": {
    "brightness": 1.0,
    "gamma": 2.2
  },

  // The show: written for the rig rather than borrowed from a relic, and the
  // first thing here that reads the beat. Its space is x flat, y running 0..1
  // from the first fixture to the last - which is what the placements below are
  // fitting the two devices into.
  "pattern": {
    "name": "mythos26",
    "state": "beat_pulse"
  },

  // Tempo in, from Mixxx.
  //
  // Setup, once:
  //
  //   1. Mixxx: Preferences > Controllers > pick its MIDI output, load the
  //      "MIDI for light" mapping, Apply. On Linux the output to pick is
  //      "eclipse-dmx IN", which is this program - start it first, because
  //      Mixxx only looks for MIDI devices once, at startup.
  //   2. In that mapping's Settings tab, leave "Enable VU mono average" on -
  //      that is note 68, the two-second average, and it is what vu_pulse's red
  //      backdrop reads. Tick "Enable VU mono current" too if you want note 64
  //      available to looks that should hit on transients. Turn OFF MTC
  //      timecode; nothing here reads it.
  //   3. Run this config.
  //
  // The mapping sends notes, not beat clock. On its "Midi Channel" setting,
  // default 1:
  //
  //     note 48   deck change
  //     note 50   the beat, velocity 100      <- beat_note
  //     note 52   the tempo, velocity bpm-50  <- bpm_note
  //     note 64   VU mono, instantaneous      <- vu_instant_note
  //     note 68   VU mono, 2-second average   <- vu_average_note
  //     note 69   VU meter bar                <- vu_meter_note
  //
  // Which is why beat_note is a number and not -1. Take any note as a beat and
  // the VU meters alone would fire dozens of times a second.
  //
  // "clock" stays on even though Mixxx sends no 0xF8: it costs nothing, and
  // "ticks" staying at 0 in `midi status` is a useful confirmation that what is
  // on this cable is what we think it is.
  //
  // Verify without guessing:
  //   echo midi monitor on | eclipse-dmx --config config/mythos26.json
  // Play a track. You should see "MIDI-IN ch=1 note_on 50 100" once a beat and
  // "note_on 52 <bpm-50>" alongside it. If the numbers differ, change
  // beat_note / bpm_note / beat_channel to match what you actually see.
  //
  // "bpm" is the tempo before anything has been heard, and the one the rig
  // falls back to if the link goes quiet. "free_run" is what makes that a
  // fallback rather than a blackout - so this config still runs on its own at a
  // bench with Mixxx nowhere in sight.
  "midi": {
    "enabled": true,

    // Where the beat comes in, and the one line in this block that is not the
    // same on every machine.
    //
    // "auto" is here rather than a name because the answer differs by platform
    // and this is one config for one show:
    //
    //   Windows   a port whose name looks like DJ software or a virtual cable -
    //             "Mixxx" straight off Mixxx if it publishes one, else the
    //             loopMIDI port sitting between them. Name it here instead if
    //             yours is called something else; `--list-midi` prints what
    //             this machine can see.
    //   Linux     nothing to find, because Mixxx does not publish a port on the
    //             ALSA sequencer - it *connects* to one. So this publishes
    //             "eclipse-dmx IN" and waits, and Mixxx is pointed at it. See
    //             "from Mixxx, on Linux" in readme.md.
    //
    // What "auto" will not do on either is guess between unrecognised ports, or
    // take a lone application on the sequencer for a tempo source. A controller
    // is a MIDI input too, and every pad on it sends notes.
    "port": "auto",

    // Never open these, whatever "port" resolution would otherwise do.
    //
    // The S2 is a controller: its pads, jogs and transport all send notes, and
    // one of them landing on note 50 would yank the beat grid mid-set. It is
    // also frequently the only MIDI input on the machine, which is exactly when
    // a fallback would reach for it. Naming "port" above already avoids it -
    // this is the belt to that pair of braces, and it keeps working if the
    // Mixxx port is missing at startup.
    "ignore": ["Traktor", "Kontrol"],

    "clock": true,
    "notes": true,
    "beat_note": 50,
    "bpm_note": 52,
    "vu_instant_note": 64,
    "vu_average_note": 68,
    "vu_meter_note": 69,
    "beat_channel": 1,
    "bpm": 128,
    "free_run": true
  },

  "devices": [
    {
      // The pillar, at the origin, in its own coordinates.
      //
      // Deliberately no "fit" or "scale": the obelisk's 0..7 across the sides
      // and 0..43 up the strips *is* its mapping, and it is the mapping every
      // Pattern_Obelisk_* look was tuned against. Squash it into the show's
      // 0..1 and obelisk_seasons goes one flat colour, because the number it
      // reads to pick a palette per face is that 0..7.
      "device": "obelisk",
      "offset": [0, 0],

      // Skinny on screen, full height - a pillar is a pillar. This is the
      // panel's size in the window and nothing else; it does not touch a single
      // coordinate the pattern sees.
      "view_scale": [0.3, 1.0],

      // Its own brightness limit is 63/255 in firmware and this sits on top of
      // it. See "the sculpture is dimmer than the picture" in readme.md.
      "brightness": 1.0
    },
    {
      // The truss, clear of the sculpture. mythos26's own space is flat in x,
      // so without an offset the pars would sit on top of the obelisk; at x 10
      // they are past its 0..7, spanning the same y so the beat hits both.
      //
      // The UV par is in here too, at the tail of the same DMX line - see the
      // device file. It is not a device of its own because it is not a wire of
      // its own, and it takes this entry's offset and brightness with the rest
      // of the truss. It samples the middle of the run, so it comes up with the
      // look rather than sitting on as a flat wash.
      "device": "uking_par36_x10",
      "name": "pars",
      "offset": [10, 0],

      // Wide and short on screen: ten pars in a line want the width and none
      // of the height.
      "view_scale": [1.7, 0.45],

      // Anything that wants the truss dimmer than the sculpture in the room
      // goes here rather than in the device file: it is a property of this
      // room, not of the lights.
      "brightness": 1.0
    },
    {
      // The colour this show sends to the screen behind it. Not a light: one
      // fixture with no wire, whose frames exist only to be read back off the
      // emit stream by
      //
      //   python -m eclipse_dmx osc config/mythos26.json --device synesthesia
      //
      // It costs a fixture in the frame stream and a small panel in the viewer,
      // and nothing on any cable. See devices/synesthesia.json and scenes/.
      "device": "synesthesia",

      // The middle of the truss - the pars span x 10..11 - because that is the
      // colour the room reads as the rig's. `fit: [0, 0]` collapses the device
      // to a point, so this offset is the whole placement. Move it to 0..7 to
      // take the colour off the obelisk instead.
      "offset": [10.5, 0],
      "fit": [0, 0],

      // One dot. It only needs to be big enough to see it moving.
      "view_scale": [0.3, 0.3]
    }
  ]
}
