{
  // Ten U'King Par 36 in series on one DMX line, 7-channel mode.
  //
  // The whole rig is one entry. The uking_par36 profile knows the channel
  // layout, "count" patches ten of them one footprint apart, and the parked
  // strobe/mode/colour channels come along for free.
  //
  // Set each fixture's own address on its display to match:
  //   par_1  ->   1      par_6  ->  36
  //   par_2  ->   8      par_7  ->  43
  //   par_3  ->  15      par_8  ->  50
  //   par_4  ->  22      par_9  ->  57
  //   par_5  ->  29      par_10 ->  64
  //
  // So par_1 occupies 1-7, par_2 occupies 8-14, and so on up to 70. That
  // leaves 442 channels free on the universe.
  //
  // Check the patch before you touch hardware:
  //   eclipse-dmx --config config/uking_par36_x10.json --show-patch
  //
  // Then confirm the physical order, one fixture at a time:
  //   eclipse-dmx --config config/uking_par36_x10.json --pattern identify

  // The widget on this rig is a bare FTDI cable - it enumerates as
  // "FT232R USB UART" with a stock, unprogrammed EEPROM, which is exactly what
  // QLC+ shows for it too. There is no firmware in it, so the host generates
  // the DMX break itself: that is "enttec_open", not "enttec_pro".
  //
  // "baud" is ignored here; the open path is always DMX's own 250000 8N2.
  "device": {
    "type": "enttec_open",
    "port": "auto",
    "fps": 24,
    "console_channels": 24
  },

  "master": {
    "brightness": 1.0,
    "gamma": 2.2
  },

  // The jacket's state machine: all of its looks, with the relic's own
  // cross-fade between them. Switch state from the viewer's buttons, or with
  // "state <name>" on stdin. "--list-patterns" still has the simpler looks.
  //
  // The rig is mapped onto the jacket's monowire - the whip - because that is
  // the segment its looks treat as one long run rather than a ring. Coordinate
  // spans come from the pattern itself; override coord_span_y here if the rig
  // wants more or less travel through a look.
  // "state" picks the opening look. Without it the machine starts on its own
  // first state, which for the jacket is digital_void - deliberately almost
  // black, and on a par rig that reads as "nothing is working".
  "pattern": {
    "name": "jacket",
    "state": "enchanted_forest",
    "speed": 0.2,
    "width": 2.0,
    "palette": "p_bluemagic"
  },

  "fixtures": [
    {
      "profile": "uking_par36",
      "name": "par",
      "address": 1,
      "count": 10
    }
  ]
}
