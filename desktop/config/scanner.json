{
  // The scanner's whole show at a desk: the ring and the obelisk side by
  // side, every game state a cue button, no hardware needed.
  //
  //   python -m eclipse_dmx view config/scanner.json
  //
  // The cue list is afterglow's own state tags - power_up, scan_idle,
  // record_countdown, void, ... - because the scanner pattern names its
  // states with them. Clicking down the list is clicking through the game,
  // and `state <tag> <seconds>` typed at the process is exactly what the
  // game sends.
  //
  // Nothing reaches a wire without --live. With it, the obelisk device's own
  // output (relic_usb, port auto) drives a plugged-in sculpture the same way
  // the game does - so a new look can be checked on screen and then on the
  // object with the same file.

  "master": {
    "brightness": 1.0,
    "gamma": 2.2
  },

  "pattern": {
    "name": "scanner"
  },

  "devices": [
    // A wide short panel for a ring, a pillar for the obelisk - view_scale
    // is a view property and touches nothing the pattern sees.
    { "device": "scanner_ring", "offset": [0, 0], "view_scale": [1.7, 0.45] },
    { "device": "obelisk",      "offset": [0, 0], "view_scale": [0.5, 1.1] }
  ]
}
