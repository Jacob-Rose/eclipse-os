{
  "version": 1,
  "bindings": [
    {
      "label": "primary hue -> hue_a",
      "trigger": {
        "pattern": "*/color/primary/hue",
        "exclude": [],
        "argument": 0
      },
      "mode": "value",
      "range": {
        "low": 0.0,
        "high": 360.0,
        "threshold": 0.5
      },
      "limit": {
        "interval": 0.03333333333333333,
        "change": 0.002,
        "keepalive": 0.2
      },
      "action": "param",
      "params": {
        "name": "hue_a",
        "low": 0.0,
        "high": 360.0,
        "layer": ""
      },
      "enabled": true
    },
