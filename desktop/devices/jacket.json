{
  // The jacket. A device definition, not a show.
  //
  // An Adafruit Feather RP2040 at the end of a USB cable, with two strips:
  //
  //   strip 0  220 px  the sleeve's seven rings, then the monowire
  //   strip 1   28 px  the pendant's two rings, 12 inner then 16 outer
  //
  //   "devices": [ { "device": "jacket", "offset": [0, 0] } ]
  //
  // The relic must be flashed with `./upload.sh jacket` - see eclipse-os.ino.
  // Generated from the hardware mapping in src/relics/jacket/jacket_io.cpp and
  // src/relics/pendant/pendant.cpp; keep the three in step.

  "name": "jacket",

  // Literal stage coordinates, in the obelisk's units, the way the scanner
  // ring's are - so place this with an offset, never a fit: a fit would
  // stretch the pendant along with the sleeve.
  //
  // The sleeve is JacketIO's own mapping on the stage. Each ring wraps the
  // arm, so its 0..1 round the arm becomes a row x 0..7 as wide as the
  // pillar, in the direction it runs - rings 1-4 forward, 5-7 back. The rings
  // stack 3 stage units apart at the foot of the stage: the wrist (ring 7) at
  // y 1, just above the floor a fire burns from, up to the shoulder (ring 1)
  // at y 19. Close enough that rain reads falling ring to ring and a flame
  // climbs the arm before it leaves it.
  //
  // The monowire starts at ring 7, the bottom ring, and runs up the arm,
  // 0.75 across drifting to 0.85: it reaches ring 1, the top ring, 70% of
  // the way along and carries on above it at the same pitch, to y 26.7 - so
  // a look moving along the rings moves along the wire with them.
  //
  // The pendant is the scanner ring's circle (radius 3.5 about (3.5, 19.5),
  // clockwise) turned a quarter clockwise, so pixel 0 is at three o'clock,
  // with the inner ring inside it - so at a
  // zero offset the sleeve stands over the obelisk and the pendant on the
  // ring, which is the only stage the mythos looks draw on (x 0..7). The
  // top of the sleeve - rings 1 and 2 - stands inside its circle.
  "coord_space": "literal",
  "space": "jacket",

  // NeoPixel's gamma32, which the jacket's own looks go through - as the
  // obelisk.
  "gamma": 2.6,

  "output": {
    "type": "relic_usb",
    "port": "auto",

    // The name the jacket answers a Hello with. The scanner carries the
    // obelisk too, and "auto" takes the relic by this name, never the first
    // to answer.
    "relic": "jacket",
    "baud": 115200,

    // The fixtures below in strip order: the first 220 pixels to strip 0, the
    // pendant's 28 to strip 1.
    "strips": [220, 28],

    // 248 WS2812s clock out in under 8ms; a deploy build's loop is ~20ms.
    "fps": 30
  },

