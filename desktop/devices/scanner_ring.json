{
  // The scanner's NeoPixel ring as a device: 35 pixels in a circle.
  //
  // The positions are a unit circle, pixel 0 at twelve o'clock, clockwise -
  // one entry per pixel because a circle is not something position_step can
  // step along. They exist for the *picture*: the viewer lays fixtures out by
  // these fields, and a ring drawn as a line is not a ring. The looks
  // themselves read the strip index (coord_space stays "normalized"), exactly
  // as on the Pi - main-py/lib/jr_lib/eclipse_engine.py builds this same rig
  // inline for the live game.
  //
  // Preview output: this device's frames only ever go to a screen - the real
  // ring is painted by the game out of the frame stream, never by a wire.

  "name": "scanner_ring",

  "output": {
    "type": "preview",
    "fps": 30
  },

